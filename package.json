{
  "name": "odin-waldo-backend",
  "version": "1.0.0",
  "description": "The Odin Project Where's Waldo Project Backend",
  "homepage": "https://github.com/Michanoku/odin-waldo-backend#readme",
  "bugs": {
    "url": "https://github.com/Michanoku/odin-waldo-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michanoku/odin-waldo-backend.git"
  },
  "license": "ISC",
  "author": "Michanoku",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test npx prisma db push && node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "db:seed": "npm prisma/seed.js",
    "db:init": "prisma migrate dev --name init",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1"
  }
}
